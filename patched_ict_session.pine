float eqPullbackAtrMultInput = input.float(0.15, "EQ Pullback ATR Threshold", minval = 0.01, step = 0.01, group = GROUP_EQ_LIQUIDITY)
int eqMinBarsBetweenInput = input.int(5, "EQ Minimum Bars Between Pivots", minval = 1, group = GROUP_EQ_LIQUIDITY)

bool showLiquiditySideInput = input.bool(true, "Show BSL/SSL", group = GROUP_LIQUIDITY_STYLE)
bool showLiquiditySourceInput = input.bool(true, "Show source", group = GROUP_LIQUIDITY_STYLE)
bool showSweptLiquidityInput = input.bool(true, "Show swept liquidity", group = GROUP_LIQUIDITY_STYLE)
bool showLiquiditySweptTextInput = input.bool(false, "Show swept text", group = GROUP_LIQUIDITY_STYLE)
color activeBslColorInput = input.color(color.rgb(59, 130, 246), "Active BSL color", group = GROUP_LIQUIDITY_STYLE)
color activeSslColorInput = input.color(color.rgb(239, 68, 68), "Active SSL color", group = GROUP_LIQUIDITY_STYLE)
color sweptLiquidityColorInput = input.color(color.rgb(156, 163, 175), "Swept color", group = GROUP_LIQUIDITY_STYLE)

const int SESSION_ASIA = 0
const int SESSION_LONDON = 1
const int SESSION_NY_AM = 2
const int SESSION_NY_LUNCH = 3
const int SESSION_NY_PM = 4

const int PREV_PDH = 0
const int PREV_PDL = 1
const int PREV_PWH = 2
const int PREV_PWL = 3
const int PREV_PMH = 4
const int PREV_PML = 5

const string SIDE_BSL = "BSL"
const string SIDE_SSL = "SSL"
const string CATEGORY_SESSION = "SESSION"
const string CATEGORY_HTF = "HTF"
const string CATEGORY_EQ = "EQ"
const float DUPLICATE_TOLERANCE_MULT = 0.5

type sessionPivot
    array<box> boxes
    array<line> hiLines
    array<line> loLines
    array<label> hiLabels
    array<label> loLabels
    // Legacy valid flags now mean the session BSL/SSL is still actively extending.
    array<bool> hiValid
    array<bool> loValid
    array<int> hiLiquidityIndices
    array<int> loLiquidityIndices
    bool sessionActive
    float activeHigh
    float activeLow
    int activeHighTime
    int activeLowTime
    int activeRightTime

type liquidity_level
    line ln
    label lb
    float price
    int start_time
    int created_time
    int label_time
    int end_time
    string source
    string side
    string category
    bool active
    bool swept
    bool hidden
    int swept_time

var sessionPivot asiaSessionState = sessionPivot.new(array.new<box>(), array.new<line>(), array.new<line>(), array.new<label>(), array.new<label>(), array.new<bool>(), array.new<bool>(), array.new<int>(), array.new<int>(), false, na, na, na, na, na)
var sessionPivot londonSessionState = sessionPivot.new(array.new<box>(), array.new<line>(), array.new<line>(), array.new<label>(), array.new<label>(), array.new<bool>(), array.new<bool>(), array.new<int>(), array.new<int>(), false, na, na, na, na, na)
var sessionPivot newYorkAmSessionState = sessionPivot.new(array.new<box>(), array.new<line>(), array.new<line>(), array.new<label>(), array.new<label>(), array.new<bool>(), array.new<bool>(), array.new<int>(), array.new<int>(), false, na, na, na, na, na)
var sessionPivot newYorkLunchSessionState = sessionPivot.new(array.new<box>(), array.new<line>(), array.new<line>(), array.new<label>(), array.new<label>(), array.new<bool>(), array.new<bool>(), array.new<int>(), array.new<int>(), false, na, na, na, na, na)
var sessionPivot newYorkPmSessionState = sessionPivot.new(array.new<box>(), array.new<line>(), array.new<line>(), array.new<label>(), array.new<label>(), array.new<bool>(), array.new<bool>(), array.new<int>(), array.new<int>(), false, na, na, na, na, na)

var array<int> sessionBoxOrder = array.new<int>()
var array<int> sessionPivotOrder = array.new<int>()

var array<liquidity_level> liquidityStore = array.new<liquidity_level>()
var array<int> sessionLiquidityOrder = array.new<int>()
var array<int> htfLiquidityOrder = array.new<int>()
var array<int> eqLiquidityOrder = array.new<int>()
var array<int> currentHtfLiquidityIndex = array.new<int>(6, -1)
var array<line> previousLevelLines = array.new<line>(6, line(na))
var array<label> previousLevelLabels = array.new<label>(6, label(na))
// Legacy valid flags now mean the HTF BSL/SSL is still actively extending.
var array<bool> previousLevelValid = array.new<bool>(6, true)

var array<box> nyAmFirstFvgBoxes = array.new<box>()
var array<label> nyAmFirstFvgLabels = array.new<label>()
var array<bool> nyAmFirstFvgValid = array.new<bool>()
var array<bool> nyAmFirstFvgBullish = array.new<bool>()
var array<int> nyAmFirstFvgCreatedTimes = array.new<int>()
var array<bool> nyAmFirstFvgCapturedState = array.new<bool>(1, false)

var array<float> lastConfirmedHighPivotPriceState = array.new<float>(1, na)
var array<int> lastConfirmedHighPivotBarState = array.new<int>(1, na)
var array<int> lastConfirmedHighPivotTimeState = array.new<int>(1, na)
var array<float> lastConfirmedLowPivotPriceState = array.new<float>(1, na)
var array<int> lastConfirmedLowPivotBarState = array.new<int>(1, na)
var array<int> lastConfirmedLowPivotTimeState = array.new<int>(1, na)

string labelSize = switch labelSizeInput
    "Tiny" => size.tiny
    "Small" => size.small
    "Large" => size.large
    => size.normal

string labelVerticalAlign = switch labelPositionInput
    "Top" => text.align_top
    "Center" => text.align_center
    => text.align_bottom

string sessionLevelStyle = switch sessionLevelStyleInput
    "Dashed" => line.style_dashed
    "Dotted" => line.style_dotted
    => line.style_solid

string previousLevelStyle = switch previousLevelStyleInput
    "Solid" => line.style_solid
    "Dotted" => line.style_dotted
    => line.style_dashed

bool timeframeAllowed = timeframe.isintraday and timeframe.in_seconds() <= timeframe.in_seconds(timeframeLimitInput)
bool sessionLevelRightSide = sessionLevelLabelSideInput == "Right Side"
bool nyAmFirstFvgPastMitigation = nyAmFirstFvgExtendModeInput == "Past Mitigation"
bool sessionLevelCutoffReached = useSessionLevelCutoffInput and not na(time(timeframe.period, sessionLevelCutoffInput, timezoneInput))
bool sweepUsesClose = sweepModeInput == "Close"
bool liquidityExtendAlways = liquidityExtendModeInput == "Always"
bool liquidityHideWhenSwept = liquidityExtendModeInput == "Hide When Swept"
bool showAnyLiquidityLabels = showLiquiditySourceInput or showLiquiditySideInput

float previousDayHigh = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_on)
float previousDayLow = request.security(syminfo.tickerid, "D", low[1], barmerge.gaps_off, barmerge.lookahead_on)
float previousWeekHigh = request.security(syminfo.tickerid, "W", high[1], barmerge.gaps_off, barmerge.lookahead_on)
float previousWeekLow = request.security(syminfo.tickerid, "W", low[1], barmerge.gaps_off, barmerge.lookahead_on)
float previousMonthHigh = request.security(syminfo.tickerid, "M", high[1], barmerge.gaps_off, barmerge.lookahead_on)
float previousMonthLow = request.security(syminfo.tickerid, "M", low[1], barmerge.gaps_off, barmerge.lookahead_on)
float eqAtr = ta.atr(14)

bool newDay = timeframe.change("D")
bool newWeek = timeframe.change("W")
bool newMonth = timeframe.change("M")

var int currentDayStartTime = na
var int currentWeekStartTime = na
var int currentMonthStartTime = na

if barstate.isfirst or newDay
    currentDayStartTime := time

if barstate.isfirst or newWeek
    currentWeekStartTime := time

if barstate.isfirst or newMonth
    currentMonthStartTime := time

method deleteOldestBox(sessionPivot this) =>
    if array.size(this.boxes) > 0
        box oldBox = array.pop(this.boxes)
        if not na(oldBox)
            box.delete(oldBox)
    true

method deleteOldestPivot(sessionPivot this) =>
    if array.size(this.hiLines) > 0
        line oldHiLine = array.pop(this.hiLines)
        line oldLoLine = array.pop(this.loLines)
        label oldHiLabel = array.pop(this.hiLabels)
        label oldLoLabel = array.pop(this.loLabels)
        array.pop(this.hiValid)
        array.pop(this.loValid)
        int oldHiLiquidityIndex = array.pop(this.hiLiquidityIndices)
        int oldLoLiquidityIndex = array.pop(this.loLiquidityIndices)

        if not na(oldHiLine)
            line.delete(oldHiLine)
        if not na(oldLoLine)
            line.delete(oldLoLine)
        if not na(oldHiLabel)
            label.delete(oldHiLabel)
        if not na(oldLoLabel)
            label.delete(oldLoLabel)

        if oldHiLiquidityIndex >= 0 and oldHiLiquidityIndex < array.size(liquidityStore)
            liquidity_level oldHiLiquidity = array.get(liquidityStore, oldHiLiquidityIndex)
            oldHiLiquidity.active := false
            oldHiLiquidity.hidden := true
            oldHiLiquidity.end_time := time
            oldHiLiquidity.ln := line(na)
            oldHiLiquidity.lb := label(na)
            array.set(liquidityStore, oldHiLiquidityIndex, oldHiLiquidity)

        if oldLoLiquidityIndex >= 0 and oldLoLiquidityIndex < array.size(liquidityStore)
            liquidity_level oldLoLiquidity = array.get(liquidityStore, oldLoLiquidityIndex)
            oldLoLiquidity.active := false
            oldLoLiquidity.hidden := true
            oldLoLiquidity.end_time := time
            oldLoLiquidity.ln := line(na)
            oldLoLiquidity.lb := label(na)
            array.set(liquidityStore, oldLoLiquidityIndex, oldLoLiquidity)
    true

deleteOldestSessionBox(int sessionId) =>
    if sessionId == SESSION_ASIA
        asiaSessionState.deleteOldestBox()
    else if sessionId == SESSION_LONDON
        londonSessionState.deleteOldestBox()
    else if sessionId == SESSION_NY_AM
        newYorkAmSessionState.deleteOldestBox()
    else if sessionId == SESSION_NY_LUNCH
        newYorkLunchSessionState.deleteOldestBox()
    else if sessionId == SESSION_NY_PM
        newYorkPmSessionState.deleteOldestBox()
    true

deleteOldestSessionPivot(int sessionId) =>
    if sessionId == SESSION_ASIA
        asiaSessionState.deleteOldestPivot()
    else if sessionId == SESSION_LONDON
        londonSessionState.deleteOldestPivot()
    else if sessionId == SESSION_NY_AM
        newYorkAmSessionState.deleteOldestPivot()
    else if sessionId == SESSION_NY_LUNCH
        newYorkLunchSessionState.deleteOldestPivot()
    else if sessionId == SESSION_NY_PM
        newYorkPmSessionState.deleteOldestPivot()
    true

trimSessionBoxes() =>
    while array.size(sessionBoxOrder) > boxesToKeepInput
        int oldSessionId = array.pop(sessionBoxOrder)
        deleteOldestSessionBox(oldSessionId)
    true

trimSessionPivots() =>
    while array.size(sessionPivotOrder) > sessionLevelsToKeepInput
        int oldSessionId = array.pop(sessionPivotOrder)
        deleteOldestSessionPivot(oldSessionId)
    true

trimNyAmFirstFvgs() =>
    while array.size(nyAmFirstFvgBoxes) > nyAmFirstFvgToKeepInput
        box oldBox = array.pop(nyAmFirstFvgBoxes)
        label oldLabel = array.pop(nyAmFirstFvgLabels)
        array.pop(nyAmFirstFvgValid)
        array.pop(nyAmFirstFvgBullish)
        array.pop(nyAmFirstFvgCreatedTimes)

        if not na(oldBox)
            box.delete(oldBox)
        if not na(oldLabel)
            label.delete(oldLabel)
    true

buildLiquidityText(string source, string side, bool swept, bool showSource, bool showSide, bool showSweptText) =>
    string liquidityText = ""

    if showSource
        liquidityText := source
    if showSide
        liquidityText := liquidityText == "" ? side : liquidityText + " | " + side
    if liquidityText != "" and swept and showSweptText
        liquidityText += " | swept"

    liquidityText

isBslSide(string side) =>
    side == SIDE_BSL

isSslSide(string side) =>
    side == SIDE_SSL

isBsl(liquidity_level level) =>
    isBslSide(level.side)

isSsl(liquidity_level level) =>
    isSslSide(level.side)

isLiquiditySwept(liquidity_level level) =>
    isBsl(level) ? (sweepUsesClose ? barstate.isconfirmed and close > level.price : high > level.price) : (sweepUsesClose ? barstate.isconfirmed and close < level.price : low < level.price)

isValidLiquidityIndex(int index) =>
    index >= 0 and index < array.size(liquidityStore)

createLiquidityMetadata(line ln, label lb, float price, int startTime, int createdTime, int labelTime, string source, string side, string category) =>
    liquidity_level newLevel = liquidity_level.new(ln, lb, price, startTime, createdTime, labelTime, createdTime, source, side, category, true, false, false, na)
    array.push(liquidityStore, newLevel)
    int newIndex = array.size(liquidityStore) - 1
    int maxKeep = category == CATEGORY_SESSION ? maxSessionLiquidityInput : category == CATEGORY_HTF ? maxHtfLiquidityInput : maxEqLiquidityInput

    if category == CATEGORY_SESSION
        array.unshift(sessionLiquidityOrder, newIndex)
        while array.size(sessionLiquidityOrder) > maxKeep
            int oldIndex = array.pop(sessionLiquidityOrder)
            if oldIndex >= 0 and oldIndex < array.size(liquidityStore)
                liquidity_level oldLevel = array.get(liquidityStore, oldIndex)
                oldLevel.active := false
                oldLevel.hidden := true
                oldLevel.end_time := time
                if not na(oldLevel.ln)
                    line.delete(oldLevel.ln)
                    oldLevel.ln := line(na)
                if not na(oldLevel.lb)
                    label.delete(oldLevel.lb)
                    oldLevel.lb := label(na)
                array.set(liquidityStore, oldIndex, oldLevel)
    else if category == CATEGORY_HTF
        array.unshift(htfLiquidityOrder, newIndex)
        while array.size(htfLiquidityOrder) > maxKeep
            int oldIndex = array.pop(htfLiquidityOrder)
            if oldIndex >= 0 and oldIndex < array.size(liquidityStore)
                liquidity_level oldLevel = array.get(liquidityStore, oldIndex)
                oldLevel.active := false
                oldLevel.hidden := true
                oldLevel.end_time := time
                if not na(oldLevel.ln)
                    line.delete(oldLevel.ln)
                    oldLevel.ln := line(na)
                if not na(oldLevel.lb)
                    label.delete(oldLevel.lb)
                    oldLevel.lb := label(na)
                array.set(liquidityStore, oldIndex, oldLevel)
    else
        array.unshift(eqLiquidityOrder, newIndex)
        while array.size(eqLiquidityOrder) > maxKeep
            int oldIndex = array.pop(eqLiquidityOrder)
            if oldIndex >= 0 and oldIndex < array.size(liquidityStore)
                liquidity_level oldLevel = array.get(liquidityStore, oldIndex)
                oldLevel.active := false
                oldLevel.hidden := true
                oldLevel.end_time := time
                if not na(oldLevel.ln)
                    line.delete(oldLevel.ln)
                    oldLevel.ln := line(na)
                if not na(oldLevel.lb)
                    label.delete(oldLevel.lb)
                    oldLevel.lb := label(na)
                array.set(liquidityStore, oldIndex, oldLevel)

    newIndex

syncLiquidityMetadata(int index, line ln, label lb, float price, int startTime, int createdTime, int labelTime, int endTime, bool active) =>
    if isValidLiquidityIndex(index)
        liquidity_level level = array.get(liquidityStore, index)
        level.ln := ln
        level.lb := lb
        level.price := price
        level.start_time := startTime
        level.label_time := labelTime
        level.end_time := endTime
        level.active := active
        array.set(liquidityStore, index, level)
    true

resetLiquidityReference(int index, line ln, label lb, float price, int startTime, int createdTime, int labelTime) =>
    if isValidLiquidityIndex(index)
        liquidity_level level = array.get(liquidityStore, index)
        level.ln := ln
        level.lb := lb
        level.price := price
        level.start_time := startTime
        level.created_time := createdTime
        level.label_time := labelTime
        level.end_time := createdTime
        level.active := true
        level.swept := false
        level.hidden := false
        level.swept_time := na
        array.set(liquidityStore, index, level)
    true

setLiquidityState(int index, bool active, bool swept, bool hidden, int eventTime) =>
    if isValidLiquidityIndex(index)
        liquidity_level level = array.get(liquidityStore, index)
        level.active := active
        level.swept := swept
        level.hidden := hidden
        level.end_time := eventTime
        level.swept_time := swept ? eventTime : na
        array.set(liquidityStore, index, level)
    true

hideLiquidityMetadata(int index) =>
    if isValidLiquidityIndex(index)
        liquidity_level level = array.get(liquidityStore, index)
        level.active := false
        level.hidden := true
        level.end_time := time
        level.ln := line(na)
        level.lb := label(na)
        array.set(liquidityStore, index, level)
    true

markLiquiditySwept(int index, int sweptTime) =>
    setLiquidityState(index, false, true, false, sweptTime)
    true

updateLiquidityLabel(int index, string labelText, int labelTime, float labelPrice, string labelStyle, color labelColor, color labelTextColor, string textSize) =>
    if isValidLiquidityIndex(index)
        liquidity_level level = array.get(liquidityStore, index)
        if not na(level.lb)
            label.set_xy(level.lb, labelTime, labelPrice)
            label.set_text(level.lb, labelText)
            label.set_style(level.lb, labelStyle)
            label.set_color(level.lb, labelColor)
            label.set_textcolor(level.lb, labelTextColor)
            label.set_size(level.lb, textSize)
    true

clearLiquidityHandles(liquidity_level level) =>
    if not na(level.ln)
        line.delete(level.ln)
        level.ln := line(na)
    if not na(level.lb)
        label.delete(level.lb)
        level.lb := label(na)
    level

isBslSwept(float price) =>
    sweepUsesClose ? barstate.isconfirmed and close > price : high > price

isSslSwept(float price) =>
    sweepUsesClose ? barstate.isconfirmed and close < price : low < price

shouldExtendLiquidity(liquidity_level level) =>
    not level.hidden and (level.active or (level.swept and liquidityExtendAlways and not liquidityHideWhenSwept))

getCategoryMaxKeep(string category) =>
    switch category
        CATEGORY_SESSION => maxSessionLiquidityInput
        CATEGORY_HTF => maxHtfLiquidityInput
        => maxEqLiquidityInput

trimLiquidityOrder(array<int> orderStore, int maxKeep) =>
    while array.size(orderStore) > maxKeep
        int oldIndex = array.pop(orderStore)
        if oldIndex >= 0 and oldIndex < array.size(liquidityStore)
            liquidity_level oldLevel = array.get(liquidityStore, oldIndex)
            oldLevel.active := false
            oldLevel.hidden := true
            oldLevel.end_time := time
            oldLevel := clearLiquidityHandles(oldLevel)
            array.set(liquidityStore, oldIndex, oldLevel)
    true

createLiquidityLevel(float price, int startTime, int createdTime, int labelTime, string source, string side, string category) =>
    liquidity_level newLevel = liquidity_level.new(line(na), label(na), price, startTime, createdTime, labelTime, createdTime, source, side, category, true, false, false, na)
    array.push(liquidityStore, newLevel)
    int newIndex = array.size(liquidityStore) - 1
    int maxKeep = category == CATEGORY_SESSION ? maxSessionLiquidityInput : category == CATEGORY_HTF ? maxHtfLiquidityInput : maxEqLiquidityInput

    if category == CATEGORY_SESSION
        array.unshift(sessionLiquidityOrder, newIndex)
        while array.size(sessionLiquidityOrder) > maxKeep
            int oldIndex = array.pop(sessionLiquidityOrder)
            if oldIndex >= 0 and oldIndex < array.size(liquidityStore)
                liquidity_level oldLevel = array.get(liquidityStore, oldIndex)
                oldLevel.active := false
                oldLevel.hidden := true
                oldLevel.end_time := time
                if not na(oldLevel.ln)
                    line.delete(oldLevel.ln)
                    oldLevel.ln := line(na)
                if not na(oldLevel.lb)
                    label.delete(oldLevel.lb)
                    oldLevel.lb := label(na)
                array.set(liquidityStore, oldIndex, oldLevel)
    else if category == CATEGORY_HTF
        array.unshift(htfLiquidityOrder, newIndex)
        while array.size(htfLiquidityOrder) > maxKeep
            int oldIndex = array.pop(htfLiquidityOrder)
            if oldIndex >= 0 and oldIndex < array.size(liquidityStore)
                liquidity_level oldLevel = array.get(liquidityStore, oldIndex)
                oldLevel.active := false
                oldLevel.hidden := true
                oldLevel.end_time := time
                if not na(oldLevel.ln)
                    line.delete(oldLevel.ln)
                    oldLevel.ln := line(na)
                if not na(oldLevel.lb)
                    label.delete(oldLevel.lb)
                    oldLevel.lb := label(na)
                array.set(liquidityStore, oldIndex, oldLevel)
    else
        array.unshift(eqLiquidityOrder, newIndex)
        while array.size(eqLiquidityOrder) > maxKeep
            int oldIndex = array.pop(eqLiquidityOrder)
            if oldIndex >= 0 and oldIndex < array.size(liquidityStore)
                liquidity_level oldLevel = array.get(liquidityStore, oldIndex)
                oldLevel.active := false
                oldLevel.hidden := true
                oldLevel.end_time := time
                if not na(oldLevel.ln)
                    line.delete(oldLevel.ln)
                    oldLevel.ln := line(na)
                if not na(oldLevel.lb)
                    label.delete(oldLevel.lb)
                    oldLevel.lb := label(na)
                array.set(liquidityStore, oldIndex, oldLevel)

    newIndex

isCategoryVisible(string category) =>
    bool categoryVisible = switch category
        CATEGORY_SESSION => showSessionLiquidityInput and showSessionLevelsInput
        CATEGORY_HTF => showHtfLiquidityInput
        => showEqLiquidityInput
    showLiquidityInput and categoryVisible

getLiquidityBaseColorFromState(string side, bool swept) =>
    swept ? sweptLiquidityColorInput : isBslSide(side) ? activeBslColorInput : activeSslColorInput

getLiquidityBaseColor(liquidity_level level) =>
    getLiquidityBaseColorFromState(level.side, level.swept)

getLiquidityLineTransparency(string category) =>
    category == CATEGORY_HTF ? previousLevelTransparencyInput : sessionLevelTransparencyInput

getLiquidityLineWidth(string category) =>
    category == CATEGORY_HTF ? previousLevelLineWidthInput : sessionLevelLineWidthInput

getLiquidityLineColor(string side, bool swept, string category) =>
    color.new(getLiquidityBaseColorFromState(side, swept), getLiquidityLineTransparency(category))

getLiquidityLabelFillColor(string side, bool swept) =>
    color.new(getLiquidityBaseColorFromState(side, swept), 100)

getLiquidityLabelTextColor(string side, bool swept, string category) =>
    getLiquidityLineColor(side, swept, category)

getLiquidityLineStyleFromState(string category, bool swept) =>
    if swept
        line.style_dotted
    else
        switch category
            CATEGORY_SESSION => sessionLevelStyle
            CATEGORY_HTF => previousLevelStyle
            => line.style_solid

getLiquidityLineStyle(liquidity_level level) =>
    getLiquidityLineStyleFromState(level.category, level.swept)

formatLiquidityLabel(string source, string side, bool swept) =>
    buildLiquidityText(source, side, swept, showLiquiditySourceInput, showLiquiditySideInput, showLiquiditySweptTextInput)

shouldDisplayLiquidityLabel(liquidity_level level) =>
    bool categoryAllowsLabels = switch level.category
        CATEGORY_SESSION => displaySessionLevelTextInput
        CATEGORY_HTF => displayPreviousLevelTextInput
        => true
    showAnyLiquidityLabels and categoryAllowsLabels

getLiquidityLabelStyleForState(string category, string side) =>
    if category == CATEGORY_SESSION
        if sessionLevelRightSide
            label.style_label_left
        else
            isBslSide(side) ? label.style_label_down : label.style_label_up
    else
        label.style_label_left

getLiquidityLabelStyle(liquidity_level level) =>
    getLiquidityLabelStyleForState(level.category, level.side)

getLiquidityLabelTime(liquidity_level level, int endTime) =>
    if level.category == CATEGORY_SESSION
        sessionLevelRightSide ? endTime : level.label_time
    else if level.category == CATEGORY_HTF
        int barMilliseconds = timeframe.in_seconds() * 1000
        shouldExtendLiquidity(level) ? time + previousLabelOffsetInput * barMilliseconds : endTime
    else
        endTime

shouldShowLiquidityObjects(liquidity_level level) =>
    not level.hidden and isCategoryVisible(level.category) and (not level.swept or showSweptLiquidityInput) and not (level.swept and liquidityHideWhenSwept)

shouldRenderLiquidity(liquidity_level level) =>
    shouldShowLiquidityObjects(level)

sendLiquiditySweepAlert(liquidity_level level) =>
    if enableLiquiditySweepAlertsInput
        alert("Swept " + level.side + ": " + level.source, alert.freq_all)
    true

renderLiquidityLevel(liquidity_level level) =>
    color lineColor = getLiquidityLineColor(level.side, level.swept, level.category)
    color labelFillColor = getLiquidityLabelFillColor(level.side, level.swept)
    color labelTextColor = getLiquidityLabelTextColor(level.side, level.swept, level.category)
    string lineStyle = getLiquidityLineStyle(level)
    int lineWidth = getLiquidityLineWidth(level.category)

    if na(level.ln)
        level.ln := line.new(level.start_time, level.price, level.end_time, level.price, xloc = xloc.bar_time, extend = extend.none, color = lineColor, style = lineStyle, width = lineWidth)
    else
        line.set_x1(level.ln, level.start_time)
        line.set_x2(level.ln, level.end_time)
        line.set_y1(level.ln, level.price)
        line.set_y2(level.ln, level.price)
        line.set_color(level.ln, lineColor)
        line.set_style(level.ln, lineStyle)
        line.set_width(level.ln, lineWidth)

    string liquidityLabelText = formatLiquidityLabel(level.source, level.side, level.swept)

    if shouldDisplayLiquidityLabel(level) and liquidityLabelText != ""
        int labelTime = getLiquidityLabelTime(level, level.end_time)
        string labelStyle = getLiquidityLabelStyle(level)
        if na(level.lb)
            level.lb := label.new(labelTime, level.price, liquidityLabelText, xloc = xloc.bar_time, style = labelStyle, color = labelFillColor, textcolor = labelTextColor, size = labelSize)
        else
            label.set_xy(level.lb, labelTime, level.price)
            label.set_text(level.lb, liquidityLabelText)
            label.set_textcolor(level.lb, labelTextColor)
            label.set_color(level.lb, labelFillColor)
            label.set_style(level.lb, labelStyle)
            label.set_size(level.lb, labelSize)
    else if not na(level.lb)
        label.delete(level.lb)
        level.lb := label(na)

    level


liquidityExistsNear(float levelPrice, string side, string category, float tolerance) =>
    bool duplicateFound = false
    int liquidityCount = array.size(liquidityStore)
    if liquidityCount > 0
        for i = 0 to liquidityCount - 1
            liquidity_level existingLevel = array.get(liquidityStore, i)
            if existingLevel.category == category and existingLevel.side == side and existingLevel.active and not existingLevel.hidden and math.abs(existingLevel.price - levelPrice) <= tolerance
                duplicateFound := true
    duplicateFound

createEqLiquidity(float price, int startTime, int createdTime, string source, string side) =>
    createLiquidityLevel(price, startTime, createdTime, createdTime, source, side, CATEGORY_EQ)

getEqPullbackLow(int barsBetween) =>
    float middleLow = na
    if barsBetween > 1
        for offset = eqRightInput + 1 to eqRightInput + barsBetween - 1
            float candidateLow = low[offset]
            middleLow := na(middleLow) ? candidateLow : math.min(middleLow, candidateLow)
    middleLow

getEqPullbackHigh(int barsBetween) =>
    float middleHigh = na
    if barsBetween > 1
        for offset = eqRightInput + 1 to eqRightInput + barsBetween - 1
            float candidateHigh = high[offset]
            middleHigh := na(middleHigh) ? candidateHigh : math.max(middleHigh, candidateHigh)
    middleHigh

// Live EQ detection helper. EQ liquidity shares the same metadata engine as other liquidity categories.
detectEqualLiquidity() =>
    if timeframeAllowed and showLiquidityInput and showEqLiquidityInput
        float lastConfirmedHighPivotPrice = array.get(lastConfirmedHighPivotPriceState, 0)
        int lastConfirmedHighPivotBar = array.get(lastConfirmedHighPivotBarState, 0)
        int lastConfirmedHighPivotTime = array.get(lastConfirmedHighPivotTimeState, 0)
        float lastConfirmedLowPivotPrice = array.get(lastConfirmedLowPivotPriceState, 0)
        int lastConfirmedLowPivotBar = array.get(lastConfirmedLowPivotBarState, 0)
        int lastConfirmedLowPivotTime = array.get(lastConfirmedLowPivotTimeState, 0)
        float confirmedPivotHigh = ta.pivothigh(high, eqLeftInput, eqRightInput)
        float confirmedPivotLow = ta.pivotlow(low, eqLeftInput, eqRightInput)

        if not na(confirmedPivotHigh) and bar_index >= eqRightInput
            int pivotBar = bar_index - eqRightInput
            int pivotTime = time[eqRightInput]
            float atrAtPivot = eqAtr[eqRightInput]
            if not na(lastConfirmedHighPivotPrice) and not na(atrAtPivot)
                int barsBetween = pivotBar - lastConfirmedHighPivotBar
                float eqThreshold = atrAtPivot * eqAtrMultInput
                float pullbackThreshold = atrAtPivot * eqPullbackAtrMultInput
                float middleLow = getEqPullbackLow(barsBetween)
                float eqPrice = (confirmedPivotHigh + lastConfirmedHighPivotPrice) / 2.0
                bool equalHighs = barsBetween >= eqMinBarsBetweenInput and math.abs(confirmedPivotHigh - lastConfirmedHighPivotPrice) <= eqThreshold
                bool hasPullback = not na(middleLow) and middleLow <= math.min(confirmedPivotHigh, lastConfirmedHighPivotPrice) - pullbackThreshold
                if equalHighs and hasPullback and not liquidityExistsNear(eqPrice, SIDE_BSL, CATEGORY_EQ, eqThreshold)
                    createEqLiquidity(eqPrice, lastConfirmedHighPivotTime, time, "EQH", SIDE_BSL)
            array.set(lastConfirmedHighPivotPriceState, 0, confirmedPivotHigh)
            array.set(lastConfirmedHighPivotBarState, 0, pivotBar)
            array.set(lastConfirmedHighPivotTimeState, 0, pivotTime)

        if not na(confirmedPivotLow) and bar_index >= eqRightInput
            int pivotBar = bar_index - eqRightInput
            int pivotTime = time[eqRightInput]
            float atrAtPivot = eqAtr[eqRightInput]
            if not na(lastConfirmedLowPivotPrice) and not na(atrAtPivot)
                int barsBetween = pivotBar - lastConfirmedLowPivotBar
                float eqThreshold = atrAtPivot * eqAtrMultInput
                float pullbackThreshold = atrAtPivot * eqPullbackAtrMultInput
                float middleHigh = getEqPullbackHigh(barsBetween)
                float eqPrice = (confirmedPivotLow + lastConfirmedLowPivotPrice) / 2.0
                bool equalLows = barsBetween >= eqMinBarsBetweenInput and math.abs(confirmedPivotLow - lastConfirmedLowPivotPrice) <= eqThreshold
                bool hasPullback = not na(middleHigh) and middleHigh >= math.max(confirmedPivotLow, lastConfirmedLowPivotPrice) + pullbackThreshold
                if equalLows and hasPullback and not liquidityExistsNear(eqPrice, SIDE_SSL, CATEGORY_EQ, eqThreshold)
                    createEqLiquidity(eqPrice, lastConfirmedLowPivotTime, time, "EQL", SIDE_SSL)
            array.set(lastConfirmedLowPivotPriceState, 0, confirmedPivotLow)
            array.set(lastConfirmedLowPivotBarState, 0, pivotBar)
            array.set(lastConfirmedLowPivotTimeState, 0, pivotTime)
    true

updateEqLiquidity() =>
    int liquidityCount = array.size(liquidityStore)
    if liquidityCount > 0
        for i = 0 to liquidityCount - 1
            liquidity_level level = array.get(liquidityStore, i)

            if level.category == CATEGORY_EQ
                if not level.hidden
                    if level.active and isLiquiditySwept(level)
                        setLiquidityState(i, false, true, liquidityHideWhenSwept, time)
                        level := array.get(liquidityStore, i)
                        sendLiquiditySweepAlert(level)

                    level := array.get(liquidityStore, i)

                    if shouldExtendLiquidity(level)
                        level.end_time := time
                        array.set(liquidityStore, i, level)
                        level := array.get(liquidityStore, i)

                    if shouldRenderLiquidity(level)
                        level := renderLiquidityLevel(level)
                    else
                        level := clearLiquidityHandles(level)
                else
                    level := clearLiquidityHandles(level)

                array.set(liquidityStore, i, level)
    true

method manageSessionPivot(
     sessionPivot this,
     simple int sessionId,
     simple bool enabled,
     simple string sessionName,
     simple string highSource,
     simple string lowSource,
     simple string sessionTime,
     simple color sessionColor
) =>
    if timeframeAllowed and enabled
        bool inSession = not na(time(timeframe.period, sessionTime, timezoneInput))
        bool inSessionPrev = bar_index > 0 ? inSession[1] : false
        bool sessionStarted = inSession and not inSessionPrev
        bool sessionEnded = not inSession and inSessionPrev
        bool sessionLiquidityVisible = showLiquidityInput and showSessionLiquidityInput and showSessionLevelsInput
        color boxColor = color.new(sessionColor, boxTransparencyInput)
        color boxTextColor = color.new(textColorInput, textTransparencyInput)
        string boxLabelText = displayTextInput ? sessionName : ""

        if sessionStarted
            this.sessionActive := true
            this.activeHigh := high
            this.activeLow := low
            this.activeHighTime := time
            this.activeLowTime := time
            this.activeRightTime := time

            if showBoxesInput
                box newBox = box.new(
                     left = time,
                     top = high,
                     right = time,
                     bottom = low,
                     xloc = xloc.bar_time,
                     border_color = boxColor,
                     border_width = 1,
                     border_style = line.style_solid,
                     bgcolor = boxColor,
                     text = boxLabelText,
                     text_color = boxTextColor,
                     text_size = labelSize,
                     text_halign = text.align_center,
                     text_valign = labelVerticalAlign,
                     force_overlay = true
                )
                array.unshift(this.boxes, newBox)
                array.unshift(sessionBoxOrder, sessionId)
                trimSessionBoxes()

        if inSession and showBoxesInput and array.size(this.boxes) > 0
            box activeBox = array.get(this.boxes, 0)
            activeBox.set_right(time)
            activeBox.set_top(math.max(activeBox.get_top(), high))
            activeBox.set_bottom(math.min(activeBox.get_bottom(), low))
            activeBox.set_bgcolor(boxColor)
            activeBox.set_border_color(boxColor)
            activeBox.set_text(boxLabelText)
            activeBox.set_text_color(boxTextColor)
            activeBox.set_text_size(labelSize)
            activeBox.set_text_valign(labelVerticalAlign)

        if inSession and this.sessionActive
            this.activeRightTime := time

            if high > this.activeHigh
                this.activeHigh := high
                this.activeHighTime := time

            if low < this.activeLow
                this.activeLow := low
                this.activeLowTime := time

        if sessionEnded and this.sessionActive
            if sessionLiquidityVisible and not na(this.activeHigh) and not na(this.activeLow)
                int pivotStartTime = this.activeRightTime
                int hiLabelTime = sessionLevelRightSide ? time : this.activeHighTime
                int loLabelTime = sessionLevelRightSide ? time : this.activeLowTime
                color hiLineColor = getLiquidityLineColor(SIDE_BSL, false, CATEGORY_SESSION)
                color loLineColor = getLiquidityLineColor(SIDE_SSL, false, CATEGORY_SESSION)
                color hiLabelFillColor = getLiquidityLabelFillColor(SIDE_BSL, false)
                color loLabelFillColor = getLiquidityLabelFillColor(SIDE_SSL, false)
                color hiLabelTextColor = getLiquidityLabelTextColor(SIDE_BSL, false, CATEGORY_SESSION)
                color loLabelTextColor = getLiquidityLabelTextColor(SIDE_SSL, false, CATEGORY_SESSION)
                string hiLabelText = formatLiquidityLabel(highSource, SIDE_BSL, false)
                string loLabelText = formatLiquidityLabel(lowSource, SIDE_SSL, false)
                string hiLabelStyle = getLiquidityLabelStyleForState(CATEGORY_SESSION, SIDE_BSL)
                string loLabelStyle = getLiquidityLabelStyleForState(CATEGORY_SESSION, SIDE_SSL)
                line newHiLine = line.new(pivotStartTime, this.activeHigh, time, this.activeHigh, xloc = xloc.bar_time, style = getLiquidityLineStyleFromState(CATEGORY_SESSION, false), color = hiLineColor, width = sessionLevelLineWidthInput)
                line newLoLine = line.new(pivotStartTime, this.activeLow, time, this.activeLow, xloc = xloc.bar_time, style = getLiquidityLineStyleFromState(CATEGORY_SESSION, false), color = loLineColor, width = sessionLevelLineWidthInput)
                label newHiLabel = label(na)
                label newLoLabel = label(na)

                if displaySessionLevelTextInput and hiLabelText != ""
                    newHiLabel := label.new(hiLabelTime, this.activeHigh, hiLabelText, xloc = xloc.bar_time, style = hiLabelStyle, color = hiLabelFillColor, textcolor = hiLabelTextColor, size = labelSize)
                if displaySessionLevelTextInput and loLabelText != ""
                    newLoLabel := label.new(loLabelTime, this.activeLow, loLabelText, xloc = xloc.bar_time, style = loLabelStyle, color = loLabelFillColor, textcolor = loLabelTextColor, size = labelSize)

                int hiLiquidityIndex = createLiquidityMetadata(newHiLine, newHiLabel, this.activeHigh, pivotStartTime, time, hiLabelTime, highSource, SIDE_BSL, CATEGORY_SESSION)
                int loLiquidityIndex = createLiquidityMetadata(newLoLine, newLoLabel, this.activeLow, pivotStartTime, time, loLabelTime, lowSource, SIDE_SSL, CATEGORY_SESSION)

                array.unshift(this.hiLines, newHiLine)
                array.unshift(this.loLines, newLoLine)
                array.unshift(this.hiLabels, newHiLabel)
                array.unshift(this.loLabels, newLoLabel)
                array.unshift(this.hiValid, true)
                array.unshift(this.loValid, true)
                array.unshift(this.hiLiquidityIndices, hiLiquidityIndex)
                array.unshift(this.loLiquidityIndices, loLiquidityIndex)
                array.unshift(sessionPivotOrder, sessionId)
                trimSessionPivots()

            this.sessionActive := false
            this.activeHigh := na
            this.activeLow := na
            this.activeHighTime := na
            this.activeLowTime := na
            this.activeRightTime := na

        if array.size(this.hiLines) > 0
            int pivotCount = array.size(this.hiLines)
            for i = 0 to pivotCount - 1
                line pivotHiLine = array.get(this.hiLines, i)
                line pivotLoLine = array.get(this.loLines, i)
                label pivotHiLabel = array.get(this.hiLabels, i)
                label pivotLoLabel = array.get(this.loLabels, i)
                bool hiCanExtend = array.get(this.hiValid, i)
                bool loCanExtend = array.get(this.loValid, i)
                int hiLiquidityIndex = array.get(this.hiLiquidityIndices, i)
                int loLiquidityIndex = array.get(this.loLiquidityIndices, i)

                if isValidLiquidityIndex(hiLiquidityIndex)
                    liquidity_level hiLevel = array.get(liquidityStore, hiLiquidityIndex)
                    if hiLevel.active and isLiquiditySwept(hiLevel)
                        setLiquidityState(hiLiquidityIndex, false, true, liquidityHideWhenSwept, time)
                        hiLevel := array.get(liquidityStore, hiLiquidityIndex)
                        sendLiquiditySweepAlert(hiLevel)
                    else if hiLevel.active and sessionLevelCutoffReached
                        setLiquidityState(hiLiquidityIndex, false, false, false, time)
                        hiLevel := array.get(liquidityStore, hiLiquidityIndex)

                    hiLevel := array.get(liquidityStore, hiLiquidityIndex)
                    bool hiShouldExtend = shouldExtendLiquidity(hiLevel)
                    int hiEndTime = hiShouldExtend ? time : hiLevel.end_time
                    bool hiShowLine = shouldShowLiquidityObjects(hiLevel)
                    string hiLabelText = formatLiquidityLabel(hiLevel.source, hiLevel.side, hiLevel.swept)
                    bool hiShowLabel = hiShowLine and shouldDisplayLiquidityLabel(hiLevel) and hiLabelText != ""
                    color hiLineColor = getLiquidityLineColor(hiLevel.side, hiLevel.swept, hiLevel.category)
                    color hiLabelFillColor = getLiquidityLabelFillColor(hiLevel.side, hiLevel.swept)
                    color hiLabelTextColor = getLiquidityLabelTextColor(hiLevel.side, hiLevel.swept, hiLevel.category)
                    string hiLineStyle = getLiquidityLineStyle(hiLevel)
                    string hiLabelStyle = getLiquidityLabelStyle(hiLevel)
                    int hiLabelTime = getLiquidityLabelTime(hiLevel, hiEndTime)

                    if hiShowLine
                        if na(pivotHiLine)
                            pivotHiLine := line.new(hiLevel.start_time, hiLevel.price, hiEndTime, hiLevel.price, xloc = xloc.bar_time, style = hiLineStyle, color = hiLineColor, width = sessionLevelLineWidthInput)
                        else
                            line.set_x1(pivotHiLine, hiLevel.start_time)
                            line.set_x2(pivotHiLine, hiEndTime)
                            line.set_y1(pivotHiLine, hiLevel.price)
                            line.set_y2(pivotHiLine, hiLevel.price)
                            line.set_color(pivotHiLine, hiLineColor)
                            line.set_style(pivotHiLine, hiLineStyle)
                            line.set_width(pivotHiLine, sessionLevelLineWidthInput)
                    else if not na(pivotHiLine)
                        line.delete(pivotHiLine)
                        pivotHiLine := line(na)

                    if hiShowLabel
                        if na(pivotHiLabel)
                            pivotHiLabel := label.new(hiLabelTime, hiLevel.price, hiLabelText, xloc = xloc.bar_time, style = hiLabelStyle, color = hiLabelFillColor, textcolor = hiLabelTextColor, size = labelSize)
                        else
                            label.set_xy(pivotHiLabel, hiLabelTime, hiLevel.price)
                            label.set_text(pivotHiLabel, hiLabelText)
                            label.set_textcolor(pivotHiLabel, hiLabelTextColor)
                            label.set_color(pivotHiLabel, hiLabelFillColor)
                            label.set_style(pivotHiLabel, hiLabelStyle)
                            label.set_size(pivotHiLabel, labelSize)
                    else if not na(pivotHiLabel)
                        label.delete(pivotHiLabel)
                        pivotHiLabel := label(na)

                    hiCanExtend := hiLevel.active
                    syncLiquidityMetadata(hiLiquidityIndex, pivotHiLine, pivotHiLabel, hiLevel.price, hiLevel.start_time, hiLevel.created_time, hiLevel.label_time, hiEndTime, hiLevel.active)

                if isValidLiquidityIndex(loLiquidityIndex)
                    liquidity_level loLevel = array.get(liquidityStore, loLiquidityIndex)
                    if loLevel.active and isLiquiditySwept(loLevel)
                        setLiquidityState(loLiquidityIndex, false, true, liquidityHideWhenSwept, time)
                        loLevel := array.get(liquidityStore, loLiquidityIndex)
                        sendLiquiditySweepAlert(loLevel)
                    else if loLevel.active and sessionLevelCutoffReached
                        setLiquidityState(loLiquidityIndex, false, false, false, time)
                        loLevel := array.get(liquidityStore, loLiquidityIndex)

                    loLevel := array.get(liquidityStore, loLiquidityIndex)
                    bool loShouldExtend = shouldExtendLiquidity(loLevel)
                    int loEndTime = loShouldExtend ? time : loLevel.end_time
                    bool loShowLine = shouldShowLiquidityObjects(loLevel)
                    string loLabelText = formatLiquidityLabel(loLevel.source, loLevel.side, loLevel.swept)
                    bool loShowLabel = loShowLine and shouldDisplayLiquidityLabel(loLevel) and loLabelText != ""
                    color loLineColor = getLiquidityLineColor(loLevel.side, loLevel.swept, loLevel.category)
                    color loLabelFillColor = getLiquidityLabelFillColor(loLevel.side, loLevel.swept)
                    color loLabelTextColor = getLiquidityLabelTextColor(loLevel.side, loLevel.swept, loLevel.category)
                    string loLineStyle = getLiquidityLineStyle(loLevel)
                    string loLabelStyle = getLiquidityLabelStyle(loLevel)
                    int loLabelTime = getLiquidityLabelTime(loLevel, loEndTime)

                    if loShowLine
                        if na(pivotLoLine)
                            pivotLoLine := line.new(loLevel.start_time, loLevel.price, loEndTime, loLevel.price, xloc = xloc.bar_time, style = loLineStyle, color = loLineColor, width = sessionLevelLineWidthInput)
                        else
                            line.set_x1(pivotLoLine, loLevel.start_time)
                            line.set_x2(pivotLoLine, loEndTime)
                            line.set_y1(pivotLoLine, loLevel.price)
                            line.set_y2(pivotLoLine, loLevel.price)
                            line.set_color(pivotLoLine, loLineColor)
                            line.set_style(pivotLoLine, loLineStyle)
                            line.set_width(pivotLoLine, sessionLevelLineWidthInput)
                    else if not na(pivotLoLine)
                        line.delete(pivotLoLine)
                        pivotLoLine := line(na)

                    if loShowLabel
                        if na(pivotLoLabel)
                            pivotLoLabel := label.new(loLabelTime, loLevel.price, loLabelText, xloc = xloc.bar_time, style = loLabelStyle, color = loLabelFillColor, textcolor = loLabelTextColor, size = labelSize)
                        else
                            label.set_xy(pivotLoLabel, loLabelTime, loLevel.price)
                            label.set_text(pivotLoLabel, loLabelText)
                            label.set_textcolor(pivotLoLabel, loLabelTextColor)
                            label.set_color(pivotLoLabel, loLabelFillColor)
                            label.set_style(pivotLoLabel, loLabelStyle)
                            label.set_size(pivotLoLabel, labelSize)
                    else if not na(pivotLoLabel)
                        label.delete(pivotLoLabel)
                        pivotLoLabel := label(na)

                    loCanExtend := loLevel.active
                    syncLiquidityMetadata(loLiquidityIndex, pivotLoLine, pivotLoLabel, loLevel.price, loLevel.start_time, loLevel.created_time, loLevel.label_time, loEndTime, loLevel.active)

                array.set(this.hiLines, i, pivotHiLine)
                array.set(this.loLines, i, pivotLoLine)
                array.set(this.hiLabels, i, pivotHiLabel)
                array.set(this.loLabels, i, pivotLoLabel)
                array.set(this.hiValid, i, hiCanExtend)
                array.set(this.loValid, i, loCanExtend)
    true

updatePreviousLevel(
     simple int slot,
     bool enabled,
     bool resetLine,
     float level,
     int lineStartTime,
     simple string levelName,
     simple string side,
     simple color baseColor,
     simple string lineStyle,
     simple int lineWidth,
     simple int lineTransparency,
     simple bool displayLabel,
     simple int labelOffset,
     simple string textSize,
     array<line> lineStore,
     array<label> labelStore,
     array<bool> validStore,
     array<int> liquidityIndexStore
) =>
    line levelLine = array.get(lineStore, slot)
    label levelLabel = array.get(labelStore, slot)
    bool levelCanExtend = array.get(validStore, slot)
    int liquidityIndex = array.get(liquidityIndexStore, slot)
    float priceTolerance = math.max(syminfo.mintick * DUPLICATE_TOLERANCE_MULT, 0.0)
    float existingLevelPrice = not na(levelLine) ? levelLine.get_y1() : isValidLiquidityIndex(liquidityIndex) ? array.get(liquidityStore, liquidityIndex).price : na
    bool unchangedLevel = resetLine and enabled and not na(level) and not na(existingLevelPrice) and math.abs(existingLevelPrice - level) <= priceTolerance
    int barMilliseconds = timeframe.in_seconds() * 1000
    int initialLabelTime = time + labelOffset * barMilliseconds

    if resetLine and unchangedLevel
        if liquidityIndex != -1
            resetLiquidityReference(liquidityIndex, levelLine, levelLabel, level, lineStartTime, time, initialLabelTime)
        levelCanExtend := true

    if resetLine and not unchangedLevel and liquidityIndex != -1
        if not na(levelLine)
            line.delete(levelLine)
            levelLine := line(na)
        if not na(levelLabel)
            label.delete(levelLabel)
            levelLabel := label(na)
        hideLiquidityMetadata(liquidityIndex)
        liquidityIndex := -1
        levelCanExtend := true

    if enabled and not na(level)
        if liquidityIndex == -1
            liquidityIndex := createLiquidityMetadata(levelLine, levelLabel, level, lineStartTime, time, initialLabelTime, levelName, side, CATEGORY_HTF)
        else if resetLine and unchangedLevel
            resetLiquidityReference(liquidityIndex, levelLine, levelLabel, level, lineStartTime, time, initialLabelTime)

        if isValidLiquidityIndex(liquidityIndex)
            liquidity_level currentLevel = array.get(liquidityStore, liquidityIndex)
            if currentLevel.active and isLiquiditySwept(currentLevel)
                setLiquidityState(liquidityIndex, false, true, liquidityHideWhenSwept, time)
                currentLevel := array.get(liquidityStore, liquidityIndex)
                sendLiquiditySweepAlert(currentLevel)

            currentLevel := array.get(liquidityStore, liquidityIndex)
            bool shouldExtendLevel = shouldExtendLiquidity(currentLevel)
            int levelEndTime = shouldExtendLevel ? time : currentLevel.end_time
            bool showLevelLine = shouldShowLiquidityObjects(currentLevel)
            string liquidityText = formatLiquidityLabel(currentLevel.source, currentLevel.side, currentLevel.swept)
            bool showLevelLabel = showLevelLine and shouldDisplayLiquidityLabel(currentLevel) and liquidityText != ""
            color levelColor = getLiquidityLineColor(currentLevel.side, currentLevel.swept, currentLevel.category)
            color labelFillColor = getLiquidityLabelFillColor(currentLevel.side, currentLevel.swept)
            color labelTextColor = getLiquidityLabelTextColor(currentLevel.side, currentLevel.swept, currentLevel.category)
            string activeLineStyle = getLiquidityLineStyle(currentLevel)
            string activeLabelStyle = getLiquidityLabelStyle(currentLevel)
            int activeLabelTime = getLiquidityLabelTime(currentLevel, levelEndTime)

            if showLevelLine
                if na(levelLine)
                    levelLine := line.new(lineStartTime, level, levelEndTime, level, xloc = xloc.bar_time, extend = extend.none, color = levelColor, style = activeLineStyle, width = lineWidth)
                else
                    line.set_x1(levelLine, lineStartTime)
                    line.set_x2(levelLine, levelEndTime)
                    line.set_y1(levelLine, level)
                    line.set_y2(levelLine, level)
                    line.set_color(levelLine, levelColor)
                    line.set_style(levelLine, activeLineStyle)
                    line.set_width(levelLine, lineWidth)
            else if not na(levelLine)
                line.delete(levelLine)
                levelLine := line(na)

            if showLevelLabel
                if na(levelLabel)
                    levelLabel := label.new(activeLabelTime, level, liquidityText, xloc = xloc.bar_time, style = activeLabelStyle, color = labelFillColor, textcolor = labelTextColor, size = textSize)
                else
                    label.set_xy(levelLabel, activeLabelTime, level)
                    label.set_text(levelLabel, liquidityText)
                    label.set_textcolor(levelLabel, labelTextColor)
                    label.set_color(levelLabel, labelFillColor)
                    label.set_style(levelLabel, activeLabelStyle)
                    label.set_size(levelLabel, textSize)
            else if not na(levelLabel)
                label.delete(levelLabel)
                levelLabel := label(na)

            levelCanExtend := currentLevel.active
            syncLiquidityMetadata(liquidityIndex, levelLine, levelLabel, level, lineStartTime, currentLevel.created_time, currentLevel.label_time, levelEndTime, currentLevel.active)
    else
        if not na(levelLine)
            line.delete(levelLine)
            levelLine := line(na)
        if not na(levelLabel)
            label.delete(levelLabel)
            levelLabel := label(na)
        hideLiquidityMetadata(liquidityIndex)
        liquidityIndex := -1
        levelCanExtend := true

    array.set(lineStore, slot, levelLine)
    array.set(labelStore, slot, levelLabel)
    array.set(validStore, slot, levelCanExtend)
    array.set(liquidityIndexStore, slot, liquidityIndex)

    true

manageNyAmFirstFvg() =>
    bool nyAmFirstFvgCaptured = array.get(nyAmFirstFvgCapturedState, 0)
    bool inNyAm = timeframeAllowed and not na(time(timeframe.period, newYorkAmSessionInput, timezoneInput))
    bool inNyAmPrev = bar_index > 0 ? inNyAm[1] : false
    bool inNyAmPrev2 = bar_index > 1 ? inNyAm[2] : false
    bool nyAmStarted = inNyAm and not inNyAmPrev

    if nyAmStarted
        nyAmFirstFvgCaptured := false
        array.set(nyAmFirstFvgCapturedState, 0, false)

    if timeframeAllowed and showNyAmFirstFvgInput and inNyAm and inNyAmPrev and inNyAmPrev2 and not nyAmFirstFvgCaptured and bar_index >= 2
        bool bullishFvg = low > high[2]
        bool bearishFvg = high < low[2]

        if bullishFvg or bearishFvg
            float fvgTop = bullishFvg ? low : low[2]
            float fvgBottom = bullishFvg ? high[2] : high
            color fvgBaseColor = bullishFvg ? nyAmFirstFvgBullColorInput : nyAmFirstFvgBearColorInput
            color fvgBoxColor = color.new(fvgBaseColor, nyAmFirstFvgTransparencyInput)
            color fvgLabelColor = color.new(fvgBaseColor, 100)
            string fvgLabelText = bullishFvg ? "1st NYAM Bull FVG" : "1st NYAM Bear FVG"
            float labelPrice = (fvgTop + fvgBottom) / 2.0
            box newFvgBox = box.new(time[2], fvgTop, time, fvgBottom, xloc = xloc.bar_time, border_color = fvgBaseColor, border_width = 1, bgcolor = fvgBoxColor, force_overlay = true)
            label newFvgLabel = label(na)

            if displayNyAmFirstFvgLabelInput
                newFvgLabel := label.new(time, labelPrice, fvgLabelText, xloc = xloc.bar_time, style = label.style_label_left, color = fvgLabelColor, textcolor = fvgBaseColor, size = labelSize)

            array.unshift(nyAmFirstFvgBoxes, newFvgBox)
            array.unshift(nyAmFirstFvgLabels, newFvgLabel)
            array.unshift(nyAmFirstFvgValid, true)
            array.unshift(nyAmFirstFvgBullish, bullishFvg)
            array.unshift(nyAmFirstFvgCreatedTimes, time)
            nyAmFirstFvgCaptured := true
            array.set(nyAmFirstFvgCapturedState, 0, true)
            trimNyAmFirstFvgs()

    if showNyAmFirstFvgInput and array.size(nyAmFirstFvgBoxes) > 0
        int fvgCount = array.size(nyAmFirstFvgBoxes)
        for i = 0 to fvgCount - 1
            box fvgBox = array.get(nyAmFirstFvgBoxes, i)
            label fvgLabel = array.get(nyAmFirstFvgLabels, i)
            bool fvgCanExtend = array.get(nyAmFirstFvgValid, i)
            bool fvgIsBullish = array.get(nyAmFirstFvgBullish, i)
            int fvgCreatedTime = array.get(nyAmFirstFvgCreatedTimes, i)
            color fvgBaseColor = fvgIsBullish ? nyAmFirstFvgBullColorInput : nyAmFirstFvgBearColorInput
            color fvgBoxColor = color.new(fvgBaseColor, nyAmFirstFvgTransparencyInput)
            color fvgLabelColor = color.new(fvgBaseColor, 100)
            string fvgLabelText = fvgIsBullish ? "1st NYAM Bull FVG" : "1st NYAM Bear FVG"
            float labelPrice = (fvgBox.get_top() + fvgBox.get_bottom()) / 2.0

            box.set_bgcolor(fvgBox, fvgBoxColor)
            box.set_border_color(fvgBox, fvgBaseColor)

            if fvgCanExtend
                fvgBox.set_right(time)

            if displayNyAmFirstFvgLabelInput
                if na(fvgLabel)
                    fvgLabel := label.new(fvgBox.get_right(), labelPrice, fvgLabelText, xloc = xloc.bar_time, style = label.style_label_left, color = fvgLabelColor, textcolor = fvgBaseColor, size = labelSize)
                else
                    if fvgCanExtend
                        label.set_x(fvgLabel, fvgBox.get_right())
                    label.set_y(fvgLabel, labelPrice)
                    label.set_text(fvgLabel, fvgLabelText)
                    label.set_textcolor(fvgLabel, fvgBaseColor)
                    label.set_color(fvgLabel, fvgLabelColor)
                    label.set_size(fvgLabel, labelSize)
            else if not na(fvgLabel)
                label.delete(fvgLabel)
                fvgLabel := label(na)

            if fvgCanExtend and not nyAmFirstFvgPastMitigation and time > fvgCreatedTime
                bool fvgMitigated = fvgIsBullish ? low <= fvgBox.get_top() : high >= fvgBox.get_bottom()
                if fvgMitigated
                    array.set(nyAmFirstFvgValid, i, false)

            array.set(nyAmFirstFvgLabels, i, fvgLabel)

    true

asiaSessionState.manageSessionPivot(SESSION_ASIA, showAsiaInput, asiaNameInput, "AS.H", "AS.L", asiaSessionInput, asiaColorInput)
londonSessionState.manageSessionPivot(SESSION_LONDON, showLondonInput, londonNameInput, "LO.H", "LO.L", londonSessionInput, londonColorInput)
newYorkAmSessionState.manageSessionPivot(SESSION_NY_AM, showNewYorkAmInput, newYorkAmNameInput, "NYAM.H", "NYAM.L", newYorkAmSessionInput, newYorkAmColorInput)
newYorkLunchSessionState.manageSessionPivot(SESSION_NY_LUNCH, showNewYorkLunchInput, newYorkLunchNameInput, "NYL.H", "NYL.L", newYorkLunchSessionInput, newYorkLunchColorInput)
newYorkPmSessionState.manageSessionPivot(SESSION_NY_PM, showNewYorkPmInput, newYorkPmNameInput, "NYPM.H", "NYPM.L", newYorkPmSessionInput, newYorkPmColorInput)

updatePreviousLevel(PREV_PDH, showLiquidityInput and showHtfLiquidityInput and showPreviousDayInput, newDay, previousDayHigh, currentDayStartTime, "PDH", SIDE_BSL, previousDayColorInput, previousLevelStyle, previousLevelLineWidthInput, previousLevelTransparencyInput, displayPreviousLevelTextInput, previousLabelOffsetInput, labelSize, previousLevelLines, previousLevelLabels, previousLevelValid, currentHtfLiquidityIndex)
updatePreviousLevel(PREV_PDL, showLiquidityInput and showHtfLiquidityInput and showPreviousDayInput, newDay, previousDayLow, currentDayStartTime, "PDL", SIDE_SSL, previousDayColorInput, previousLevelStyle, previousLevelLineWidthInput, previousLevelTransparencyInput, displayPreviousLevelTextInput, previousLabelOffsetInput, labelSize, previousLevelLines, previousLevelLabels, previousLevelValid, currentHtfLiquidityIndex)
updatePreviousLevel(PREV_PWH, showLiquidityInput and showHtfLiquidityInput and showPreviousWeekInput, newWeek, previousWeekHigh, currentWeekStartTime, "PWH", SIDE_BSL, previousWeekColorInput, previousLevelStyle, previousLevelLineWidthInput, previousLevelTransparencyInput, displayPreviousLevelTextInput, previousLabelOffsetInput, labelSize, previousLevelLines, previousLevelLabels, previousLevelValid, currentHtfLiquidityIndex)
updatePreviousLevel(PREV_PWL, showLiquidityInput and showHtfLiquidityInput and showPreviousWeekInput, newWeek, previousWeekLow, currentWeekStartTime, "PWL", SIDE_SSL, previousWeekColorInput, previousLevelStyle, previousLevelLineWidthInput, previousLevelTransparencyInput, displayPreviousLevelTextInput, previousLabelOffsetInput, labelSize, previousLevelLines, previousLevelLabels, previousLevelValid, currentHtfLiquidityIndex)
updatePreviousLevel(PREV_PMH, showLiquidityInput and showHtfLiquidityInput and showPreviousMonthInput, newMonth, previousMonthHigh, currentMonthStartTime, "PMH", SIDE_BSL, previousMonthColorInput, previousLevelStyle, previousLevelLineWidthInput, previousLevelTransparencyInput, displayPreviousLevelTextInput, previousLabelOffsetInput, labelSize, previousLevelLines, previousLevelLabels, previousLevelValid, currentHtfLiquidityIndex)
updatePreviousLevel(PREV_PML, showLiquidityInput and showHtfLiquidityInput and showPreviousMonthInput, newMonth, previousMonthLow, currentMonthStartTime, "PML", SIDE_SSL, previousMonthColorInput, previousLevelStyle, previousLevelLineWidthInput, previousLevelTransparencyInput, displayPreviousLevelTextInput, previousLabelOffsetInput, labelSize, previousLevelLines, previousLevelLabels, previousLevelValid, currentHtfLiquidityIndex)

detectEqualLiquidity()
updateEqLiquidity()

// Session + HTF own their objects directly; EQ runs through the shared metadata renderer.
manageNyAmFirstFvg()
