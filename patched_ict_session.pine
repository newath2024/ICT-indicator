int eqLeftInput = input.int(3, "EQ Pivot Left", minval = 1, group = GROUP_EQ_LIQUIDITY)
int eqRightInput = input.int(3, "EQ Pivot Right", minval = 1, group = GROUP_EQ_LIQUIDITY)
